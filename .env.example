# Salin file ini jadi ".env" lalu isi password database sebelum menjalankan docker compose.
# Jangan commit file ".env" yang sudah berisi password asli ke git.

PGPASSWORD=ganti_dengan_password_yang_kuat

# Retensi data posisi GPS -- format <angka>d/w/m/y (hari/minggu/bulan/tahun)
# RETENTION=90d

# Jadwal backup database otomatis -- daily / weekly / monthly / off
# BACKUP=monthly

# Jumlah file backup terakhir yang disimpan (lebih lama dari ini otomatis dihapus)
# BACKUP_KEEP=6

# Opsional, kalau mau ganti dari default:
# PGDATABASE=gt06
# PGUSER=gt06
# GT06_PORT=5023
# WEB_PORT=8083
