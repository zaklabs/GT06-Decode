# Salin file ini jadi ".env" lalu isi password database sebelum menjalankan docker compose.
# Jangan commit file ".env" yang sudah berisi password asli ke git.

PGPASSWORD=ganti_dengan_password_yang_kuat

# Opsional, kalau mau ganti dari default:
# PGDATABASE=gt06
# PGUSER=gt06
# GT06_PORT=5023
# WEB_PORT=8083
