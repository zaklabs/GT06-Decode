# Salin file ini jadi ".env" lalu isi password database & admin sebelum menjalankan docker compose.
# Jangan commit file ".env" yang sudah berisi password asli ke git.

PGPASSWORD=ganti_dengan_password_yang_kuat

# Kredensial Basic Auth untuk dashboard web internal, tab "Akses API" (kelola token)
# dan endpoint internal (reload-devices). WAJIB diisi -- tidak ada default.
# Kalau kosong: dashboard & manajemen token dinonaktifkan (HTTP 503), tapi ingest
# GT06 dan /api/external/* (Bearer token) tetap jalan.
# Buat password acak, mis.: openssl rand -base64 24
# ADMIN_USER=admin
ADMIN_PASSWORD=

# Interface host untuk port web (dashboard + API). Default 127.0.0.1 = hanya bisa
# diakses dari server itu sendiri (SSH tunnel / reverse proxy). Set 0.0.0.0 hanya
# kalau memang perlu diakses langsung dari jaringan lain (sebaiknya di belakang HTTPS).
# WEB_BIND=127.0.0.1

# Retensi data posisi GPS -- format <angka>d/w/m/y (hari/minggu/bulan/tahun)
# RETENTION=90d

# Jadwal backup database otomatis -- daily / weekly / monthly / off
# BACKUP=monthly

# Jumlah file backup terakhir yang disimpan (lebih lama dari ini otomatis dihapus)
# BACKUP_KEEP=6

# Batas koneksi TCP GT06 simultan
# GT06_MAX_CONNECTIONS=1000

# Daftar IMEI perangkat yang diizinkan: off | log | on
#   log (default): semua perangkat diterima, yang belum terdaftar dicatat di log
#   on           : hanya perangkat terdaftar & aktif yang diterima
# GT06_IMEI_ENFORCE=log

# Opsional, kalau mau ganti dari default:
# PGDATABASE=gt06
# PGUSER=gt06
# GT06_PORT=5023
# WEB_PORT=8083
